# Giao diện HMICO — build tĩnh rồi phục vụ bằng Caddy (15/09/2026).
# Caddy tự xin và gia hạn chứng chỉ Let's Encrypt cho DOMAIN, phục vụ file
# tĩnh, và chuyển /api/* sang container api — không cần nginx/certbot trên
# máy chủ. Frontend gọi API bằng đường tương đối /api nên KHÔNG có CORS.
FROM node:22-bookworm-slim AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
ENV VITE_API_URL=/api
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /web/dist /srv
