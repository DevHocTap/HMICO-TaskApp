# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.

DATABASE_URL="postgresql://kpi_dev:MAT_KHAU_DATABASE@localhost:5432/kpi_db?schema=public"

# Chuỗi ký JWT — bắt buộc, tối thiểu 32 ký tự. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Access token ngắn hạn, refresh token dài hạn (docs/quy-tac-nghiep-vu.md mục 7)
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

PORT=3000

# Địa chỉ frontend được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Số lần đăng nhập tối đa mỗi phút cho MỘT CẶP (địa chỉ IP, email). Mặc định 5.
# Khoá theo cả email chứ không chỉ IP: cả công ty sau NAT dùng chung một IP
# công cộng, khoá theo IP thuần thì một người gõ sai là chặn nhầm người khác.
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Hạn mức đăng nhập theo MỘT ĐỊA CHỈ IP, mỗi phút. Mặc định 120.
# Đây KHÔNG phải lớp chống dò mật khẩu (lớp đó là LOGIN_RATE_LIMIT_PER_MINUTE
# ở trên, khoá theo cặp IP + email). Lớp này chỉ chặn một máy gọi điên loạn,
# nên phải đủ rộng cho cả công ty đăng nhập cùng lúc sau NAT.
LOGIN_RATE_LIMIT_IP_PER_MINUTE=120

# Số lớp proxy phía trước. 0 khi chạy trực tiếp; đặt 1 khi chạy sau nginx.
# Quên đặt thì mọi request mang IP của nginx: hạn mức theo IP vô nghĩa và
# AuditLog ghi sai địa chỉ cho mọi thao tác.
TRUST_PROXY=0
