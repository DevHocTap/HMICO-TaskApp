# Sao chép thành .env.production (KHÔNG commit) và điền từng dòng.
#   Windows PowerShell:  Copy-Item .env.production.example .env.production

# ---- Tên miền — đã trỏ A record về IP tĩnh của công ty ----
DOMAIN=hmicodev.io.vn

# ---- Database (chỉ trong mạng Docker, không mở ra ngoài) ----
DB_USER=kpi
DB_NAME=kpi
# Mật khẩu MẠNH, khác hẳn máy dev. Sinh:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=DOI_MAT_KHAU_NAY

# ---- Bảo mật ----
# Bắt buộc ≥ 32 ký tự, sinh mới, KHÔNG dùng lại của máy dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=DOI_CHUOI_NAY
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_IP_PER_MINUTE=120

# ---- Sao lưu ----
# Thư mục TRÊN MÁY WINDOWS chứa bản sao lưu (tạo trước). Dùng dấu / :
BACKUP_HOST_DIR=D:/kpi-backups
# Bản thứ hai — ổ ngoài / NAS gắn vào máy. Bỏ trống hai dòng này nếu chưa có.
# Khi có: đặt CẢ HAI, ví dụ  BACKUP_MIRROR_HOST_DIR=E:/kpi-backups  và  BACKUP_MIRROR_DIR=/backups-mirror
BACKUP_MIRROR_HOST_DIR=
BACKUP_MIRROR_DIR=

# ---- Tài khoản quản trị đầu tiên (chỉ dùng cho bước bootstrap, xoá sau khi xong) ----
BOOTSTRAP_ADMIN_EMAIL=admin@hmico.vn
BOOTSTRAP_ADMIN_PASSWORD=DOI_MAT_KHAU_NAY
