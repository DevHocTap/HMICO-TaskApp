// Nguồn sự thật nghiệp vụ: docs/quy-tac-nghiep-vu.md
// Giai đoạn 1 chỉ làm KPI cá nhân (ownerType = USER).
// Đã bỏ: KpiDefinition, KpiAssignment, KpiResult, Approval.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== LÕI TỔ CHỨC =====

model Department {
  id       String       @id @default(uuid())
  code     String       @unique
  name     String
  parentId String?
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")

  // Trưởng bộ phận — dùng để định tuyến duyệt.
  // Nullable vì tạo phòng và tạo người là hai bước (phụ thuộc vòng).
  managerId String?
  manager   User?   @relation("DeptManager", fields: [managerId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]      @relation("UserDepartment")
  jobTitles    JobTitle[]
  scorecards   Scorecard[]
  kpiTemplates KpiTemplate[]

  @@index([parentId])
}

model JobTitle {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  // Phòng ban áp dụng. Null = dùng chung toàn công ty.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  templates  KpiTemplate[]
  scorecards Scorecard[]

  @@index([departmentId])
}

enum Role {
  ADMIN
  EXECUTIVE
  HR
  MANAGER
  STAFF
}

model User {
  id           String @id @default(uuid())
  employeeCode String @unique
  email        String @unique
  fullName     String
  passwordHash String
  role         Role   @default(STAFF)

  departmentId String?
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id])

  jobTitleId String?
  jobTitle   JobTitle? @relation(fields: [jobTitleId], references: [id])

  // Cấp bậc — biểu mẫu có ô "Cấp bậc (Level)", để chuỗi tự do
  level String?

  // Quan hệ báo cáo. CHỈ để hiển thị — KHÔNG dùng quyết định quyền xem.
  // Phạm vi dữ liệu đi theo cây Department (xem docs mục 7).
  managerId String?
  manager   User?   @relation("ReportsTo", fields: [managerId], references: [id])
  reports   User[]  @relation("ReportsTo")

  // Chuẩn bị SSO Microsoft, giai đoạn 1 để trống
  azureAdObjectId String? @unique

  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  managedDepartments   Department[]     @relation("DeptManager")
  createdKpiTemplates  KpiTemplate[]    @relation("KpiTemplateCreator")
  lockedPeriods        Period[]         @relation("PeriodLocker")
  createdPeriods       Period[]         @relation("PeriodCreator")
  proposedScorecards   Scorecard[]      @relation("ScorecardProposer")
  refreshTokens        RefreshToken[]
  scorecards           Scorecard[]      @relation("ScorecardOwner")
  evaluatingScorecards Scorecard[]      @relation("ScorecardEvaluator")
  createdScorecards    Scorecard[]      @relation("ScorecardCreator")
  receivedScorecards   Scorecard[]      @relation("ScorecardReceiver")
  scorecardEvents      ScorecardEvent[]
  auditLogs            AuditLog[]

  @@index([departmentId])
  @@index([managerId])
  @@index([jobTitleId])
}

// ===== PHIÊN ĐĂNG NHẬP =====

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 dạng hex của token. Không lưu token thô.
  // Không cần argon2: token đã là 32 byte ngẫu nhiên, entropy cao.
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  // Xoay vòng: trỏ tới token kế nhiệm khi refresh
  replacedById String?

  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ===== KỲ ĐÁNH GIÁ =====

enum PeriodType {
  MONTH
  QUARTER
  YEAR
}

model Period {
  id String @id @default(uuid())

  /// Khoá idempotent cho việc tự sinh kỳ: "2026-09", "2026-Q3", "2026".
  /// Nhờ nó, tác vụ định kỳ chạy lại bao nhiêu lần cũng chỉ ra một kỳ.
  code String @unique

  name String     @unique
  type PeriodType

  // Tháng thuộc quý, quý thuộc năm. Điểm quý = trung bình cộng ba tháng.
  parentId String?
  parent   Period?  @relation("PeriodTree", fields: [parentId], references: [id])
  children Period[] @relation("PeriodTree")

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// Bốn mốc trong tháng (docs mục 5.5, HCNS chốt 03/09/2026).
  /// CHỈ kỳ MONTH mới có; kỳ quý và năm để NULL.
  /// Là dữ liệu chứ không hard-code, vì công ty có thể đổi mốc.
  ///
  /// Hạn trưởng phòng lên KPI cho kỳ này — ngày 25 THÁNG TRƯỚC kỳ đó.
  assignDeadline DateTime? @db.Date
  /// Hạn nhân viên tự đánh giá — ngày 25 của chính kỳ đó.
  selfScoreDeadline DateTime? @db.Date
  /// Hạn trưởng phòng chấm xong và chốt — ngày 29.
  managerScoreDeadline DateTime? @db.Date
  /// Hạn trưởng phòng gửi HCNS tổng hợp — ngày 30.
  submitDeadline DateTime? @db.Date

  /// Khoá kỳ CHỈ ảnh hưởng chính kỳ đó, không lan xuống kỳ con.
  /// Khoá quý không khoá ba tháng bên trong — xem docs mục 5.6.
  isLocked   Boolean   @default(false)
  lockedAt   DateTime?
  lockedById String?
  lockedBy   User?     @relation("PeriodLocker", fields: [lockedById], references: [id])

  /// NULL nghĩa là hệ thống tự tạo bằng tác vụ định kỳ, không phải người tạo.
  createdById String?
  createdBy   User?   @relation("PeriodCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scorecards Scorecard[]

  @@index([startDate, endDate])
  @@index([parentId])
}

// ===== MẪU KPI =====

enum KpiSection {
  BSC_WORK
  COMPLIANCE
}

enum KpiDirection {
  HIGHER_BETTER
  LOWER_BETTER
}

enum ScoringMode {
  MANUAL
  CALCULATED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
}

model KpiTemplate {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  jobTitleId String?
  jobTitle   JobTitle? @relation(fields: [jobTitleId], references: [id])

  // Mẫu hệ thống (3 tiêu chí Mục 2 "Chấp hành nội quy") — tự nối vào mọi
  // phiếu, chỉ ADMIN sửa được qua endpoint riêng, không cho xoá.
  isSystem Boolean @default(false)

  // Mẫu nội quy CỦA MỘT PHÒNG (chốt 13/09/2026): `isSystem = true` kèm
  // `departmentId`. Trưởng bộ phận soạn cho phòng mình; sinh phiếu ưu tiên
  // mẫu này (đã xuất bản), không có thì dùng mẫu chung (`departmentId = null`).
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // PUBLISHED nghĩa là "nội dung này đã qua kiểm tra trọng số". Sửa cây
  // item của mẫu đã PUBLISHED sẽ tự đưa nó về DRAFT — nếu không, trạng
  // thái sẽ nói dối về nội dung bên trong.
  status TemplateStatus @default(DRAFT)

  // Tăng mỗi lần xuất bản lại. Phiếu chốt lại số này ở templateVersion.
  version Int @default(1)

  createdById String?
  createdBy   User?   @relation("KpiTemplateCreator", fields: [createdById], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            KpiTemplateItem[]
  scorecards       Scorecard[]       @relation("ScorecardTemplate")
  systemScorecards Scorecard[]       @relation("ScorecardSystemTemplate")

  @@index([jobTitleId])
  @@index([departmentId])
  @@index([status])
}

// Tự chứa toàn bộ nội dung — không còn bảng KpiDefinition.
// Lý do: ở tầng cá nhân tiêu chí gắn chặt với chức danh, gần như không
// dùng chéo. Vai trò "thư viện" đã chuyển sang KpiTemplate.
model KpiTemplateItem {
  id         String      @id @default(uuid())
  templateId String
  template   KpiTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Hai cấp: tiêu chí cấp 1 (parentId = null) và KPI con.
  parentId String?
  parent   KpiTemplateItem?  @relation("TemplateItemTree", fields: [parentId], references: [id])
  children KpiTemplateItem[] @relation("TemplateItemTree")

  section      KpiSection
  displayOrder Int
  name         String
  description  String?

  // Mục tiêu, NGUYÊN VĂN như biểu mẫu Excel: "≥ 95%", "≤ 1 lỗi/tháng",
  // "2 giờ", "0", "Đạt". Cố ý là chuỗi tự do, không chuẩn hoá — ép mọi
  // mục tiêu về số tốn rất nhiều công mà giai đoạn 1 chưa dùng tới.
  measurementText String?

  // Cột "Cách đo" trong biểu mẫu.
  measureMethod String?

  // Ba cột dưới chỉ dùng khi scoringMode = CALCULATED (hướng B, chưa bật).
  // Giữ sẵn vì công thức hướng B cần chúng; thiếu thì CALCULATED vô nghĩa.
  targetValue Decimal?     @db.Decimal(18, 4)
  minValue    Decimal?     @db.Decimal(18, 4)
  direction   KpiDirection @default(HIGHER_BETTER)
  scoringMode ScoringMode  @default(MANUAL)

  weight Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId, section, displayOrder])
  @@index([parentId])
}

// ===== PHIẾU KPI =====

enum OwnerType {
  COMPANY
  DEPARTMENT
  USER
}

// Luồng giao KPI đầu kỳ
enum AssignStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  DISPUTED
}

// Luồng chấm điểm cuối kỳ
enum ResultStatus {
  PENDING
  SELF_SCORED
  MANAGER_SCORED
  REJECTED
  RECEIVED
}

enum Grade {
  NOT_ACHIEVED
  NEEDS_IMPROVEMENT
  COMPLETED
  EXCEEDED
}

model Scorecard {
  id String @id @default(uuid())

  // Giai đoạn 1 luôn là USER. Giữ cột cho tương lai (KPI phòng ban).
  ownerType OwnerType @default(USER)

  /// Nullable để dành cho ownerType = DEPARTMENT sau này. Giai đoạn 1 luôn
  /// có giá trị; service từ chối mọi ownerType khác USER.
  ownerUserId String?
  ownerUser   User?   @relation("ScorecardOwner", fields: [ownerUserId], references: [id])

  periodId String
  period   Period @relation(fields: [periodId], references: [id])

  // --- Snapshot: người đổi chức danh giữa năm thì phiếu cũ giữ nguyên ---
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  departmentName String

  jobTitleId    String?
  jobTitle      JobTitle? @relation(fields: [jobTitleId], references: [id])
  jobTitleName  String
  employeeLevel String?

  templateId      String?
  template        KpiTemplate? @relation("ScorecardTemplate", fields: [templateId], references: [id])
  templateVersion Int?

  /// Mẫu Mục 2 đã ghép vào phiếu, để tra ngược nguồn gốc.
  systemTemplateId String?
  systemTemplate   KpiTemplate? @relation("ScorecardSystemTemplate", fields: [systemTemplateId], references: [id])

  // Người chấm được chốt từ đầu kỳ, không suy ra lúc chấm
  evaluatorId String?
  evaluator   User?   @relation("ScorecardEvaluator", fields: [evaluatorId], references: [id])

  // --- Luồng 1: giao KPI ---
  //
  // Bốn cột dấu vết dưới đây là BẢN SAO CHO NHANH của sự kiện mới nhất
  // trong ScorecardEvent. ScorecardEvent mới là nguồn sự thật: phiếu bị
  // trả lại hai lần thì lý do lần đầu chỉ còn ở đó.
  // Cả hai luôn ghi cùng một transaction, qua đúng một hàm.
  assignStatus  AssignStatus @default(DRAFT)
  proposedAt    DateTime?
  proposedById  String?
  proposedBy    User?        @relation("ScorecardProposer", fields: [proposedById], references: [id])
  acceptedAt    DateTime?
  disputedAt    DateTime?
  disputeReason String?

  // --- Luồng 2: chấm điểm ---
  resultStatus    ResultStatus @default(PENDING)
  selfScoredAt    DateTime?
  managerScoredAt DateTime?

  // Dấu vết lần TRẢ LẠI gần nhất. Cố ý tách khỏi `disputedAt`/`disputeReason`:
  // hai cột kia thuộc luồng GIAO KPI (nhân viên nêu ý kiến về nội dung KPI
  // đầu kỳ), còn đây là người chấm trả phiếu về cuối kỳ. Gộp chung thì lý do
  // đầu kỳ bị ghi đè. Nguồn sự thật vẫn là ScorecardEvent.
  rejectedAt   DateTime?
  rejectReason String?

  receivedAt      DateTime?
  receivedById    String?
  receivedBy      User?        @relation("ScorecardReceiver", fields: [receivedById], references: [id])

  // Nghỉ việc giữa kỳ: trưởng phòng chấm một cột, bắt buộc ghi lý do
  noSelfScoreReason String?

  // Chốt khi chuyển sang MANAGER_SCORED
  selfTotalScore    Decimal? @db.Decimal(6, 2)
  managerTotalScore Decimal? @db.Decimal(6, 2)
  grade             Grade?

  createdById String
  createdBy   User     @relation("ScorecardCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items  ScorecardItem[]
  events ScorecardEvent[]

  // Chặn tạo trùng phiếu — nút "sao chép từ kỳ trước" chắc chắn sẽ bấm nhầm.
  // PostgreSQL coi các NULL là khác nhau, nên ràng buộc này chỉ áp cho phiếu
  // có chủ sở hữu; phiếu cấp phòng ban sau này không bị vướng.
  @@unique([ownerUserId, periodId])
  @@index([departmentId, periodId])
  @@index([periodId, resultStatus])
  @@index([evaluatorId, resultStatus])
}

// Snapshot nội dung KPI tại thời điểm tạo phiếu.
// KHÔNG trỏ FK về KpiTemplateItem để đọc ngược: sửa mẫu không được làm
// đổi phiếu đã chấm — sai ở đây là sai vào lương người thật.
model ScorecardItem {
  id          String    @id @default(uuid())
  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ScorecardItem?  @relation("ItemTree", fields: [parentId], references: [id])
  children ScorecardItem[] @relation("ItemTree")

  /// CHỈ để tra nguồn gốc. KHÔNG bao giờ đọc nội dung từ mẫu qua cột này:
  /// mẫu sửa về sau không được làm đổi phiếu đã lập.
  templateItemId String?

  section         KpiSection
  displayOrder    Int
  name            String
  description     String?
  measurementText String?
  measureMethod   String?

  targetValue Decimal?      @db.Decimal(18, 4)
  minValue    Decimal?      @db.Decimal(18, 4)
  direction   KpiDirection?
  scoringMode ScoringMode   @default(MANUAL)

  // Chụp lại từ hằng số theo section (BSC_WORK: 10, COMPLIANCE: 3).
  // Công ty đổi thang sang 100 năm sau thì phiếu cũ vẫn giữ thang 10.
  maxScale Int

  weight Decimal @db.Decimal(5, 2)

  // Hai cột chấm. Chỉ tiêu chí lá mới được nhập; tiêu chí có con tính
  // từ con trong service, không lưu.
  selfScore      Decimal? @db.Decimal(6, 2)
  selfComment    String?
  managerScore   Decimal? @db.Decimal(6, 2)
  managerComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scorecardId, section, displayOrder])
  @@index([parentId])
}

// Thay bảng Approval cũ: một phiếu có thể bị trả lại nhiều lần,
// mỗi lần một lý do — một cột comment sẽ bị ghi đè.
enum ScorecardAction {
  /// Phiếu được sinh ra (từ mẫu, hoặc chép từ kỳ trước)
  CREATE
  /// Sửa cây item của phiếu
  UPDATE_ITEMS
  PROPOSE
  /// Gửi lại nguyên trạng từ DISPUTED sau khi hai bên đã trao đổi trực tiếp.
  /// Bắt buộc kèm ghi chú — xem docs/quy-tac-nghiep-vu.md mục 5.1.
  RE_PROPOSED_UNCHANGED
  ACCEPT
  DISPUTE
  SELF_SCORE
  MANAGER_SCORE
  REJECT
  RECEIVE
  REOPEN
}

model ScorecardEvent {
  id          String    @id @default(uuid())
  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  action  ScorecardAction
  actorId String
  actor   User            @relation(fields: [actorId], references: [id])
  comment String?

  createdAt DateTime @default(now())

  @@index([scorecardId, createdAt])
}

// Cấu hình dùng chung toàn công ty, mỗi nhóm một dòng (`lichKy`,
// `nguongXepLoai`, `baoMat`, `kyDanhGia`, `chamDiem`). Hình dạng `value`
// của từng nhóm và giá trị mặc định nằm ở
// src/modules/settings/cai-dat-mac-dinh.ts — dòng không tồn tại nghĩa là
// dùng mặc định, KHÔNG seed sẵn.
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Cố ý không có khoá ngoại tới bảng nghiệp vụ: phiếu bị xoá thì log
// vẫn phải còn — đó chính là lúc cần tra cứu nhất.
model AuditLog {
  id      String  @id @default(uuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
